{
  "tools": [
    {
      "name": "pull_ticket",
      "description": "List projects and tickets from a source",
      "inputSchema": {
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "allProjects": { "type": "boolean" }
        }
      },
      "response": {
        "projects": [
          { "name": "example-org/lumio", "id": "lumio-repo-id", "type": "github" }
        ]
      }
    },
    {
      "name": "create_issue",
      "description": "Create an issue in a GitHub repository",
      "inputSchema": {
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "repo": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" }
        },
        "required": ["source", "repo", "title", "description"]
      },
      "response": "{{dynamic}}"
    }
  ]
}
