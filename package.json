{
  "name": "agentic-skills-bundle",
  "version": "1.0.0",
  "description": "A guided CLI installer for AI agent skills (frontend & backend)",
  "type": "module",
  "bin": {
    "agentic-skills": "bin/install.js",
    "agentic-skills-uninstall": "bin/uninstall.js"
  },
  "scripts": {
    "prepack": "mvn -q -DskipTests clean package -f bin/agentic-skills-cli/pom.xml && mvn -q -DskipTests clean package -f hooks/agentic-skills-hooks/pom.xml",
    "start": "node bin/install.js",
    "test": "mvn test -f bin/agentic-skills-cli/pom.xml -Dtest=AgentFileStructureTest,SkillFileStructureTest,CommandFileStructureTest",
    "test:hooks": "mvn -q -DskipTests package -f hooks/agentic-skills-hooks/pom.xml && vitest run --config hooks/vitest.config.ts hooks/tests",
    "test:cli": "mvn -f bin/agentic-skills-cli/pom.xml test",
    "test:security-scanner": "mvn -f mcp/security-scanner/pom.xml test",
    "test:issue-tickets": "mvn -f mcp/issue-tickets/pom.xml test",
    "eval": "mvn -f evals/agentic-skills-evals/pom.xml test",
    "eval:select": "mvn -q -DskipTests package -f evals/agentic-skills-evals/pom.xml && java -cp evals/agentic-skills-evals/target/agentic-skills-evals.jar dev.dorrian.agenticskillsevals.cli.EvalCli select",
    "report": "mvn -q -DskipTests package -f evals/agentic-skills-evals/pom.xml && java -cp evals/agentic-skills-evals/target/agentic-skills-evals.jar dev.dorrian.agenticskillsevals.cli.EvalCli report",
    "eval:baseline": "mvn -q -DskipTests package -f evals/agentic-skills-evals/pom.xml && java -cp evals/agentic-skills-evals/target/agentic-skills-evals.jar dev.dorrian.agenticskillsevals.cli.EvalCli report --save-baseline"
  },
  "files": [
    "bin/install.js",
    "bin/uninstall.js",
    "bin/agentic-skills-cli/target/agentic-skills-cli.jar",
    "hooks/agentic-skills-hooks/target/agentic-skills-hooks.jar",
    "skills",
    "agents",
    "mcp",
    ".opencode",
    "templates"
  ],
  "keywords": [
    "ai",
    "skills",
    "claude",
    "opencode",
    "cursor",
    "vscode",
    "copilot",
    "agent",
    "cli",
    "installer"
  ],
  "author": "Ashleigh Dorrian",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
