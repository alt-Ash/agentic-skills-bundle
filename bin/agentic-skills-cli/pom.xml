<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.dorrian.agenticskillscli</groupId>
  <artifactId>agentic-skills-cli</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.18.4</version>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>2.4</version>
    </dependency>
    <dependency>
      <groupId>org.jline</groupId>
      <artifactId>jline</artifactId>
      <version>3.26.3</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.12.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>agentic-skills-cli</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.dorrian.agenticskillscli.App</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <!--
            Redirect every path AgentToolRegistry/McpConfigRegistry/the MCP
            installers/ShellProfileEnvWriter resolve at test-JVM class-load
            time (via HomeDir.resolve()) at a scratch directory under
            target/, so the whole suite never reads or writes the real
            developer's $HOME. This is what makes positive-path detector
            tests (see detect/InstalledSkillAgentCommandDetectorTest)
            possible without touching real machine state.
          -->
          <!--
            The HOME override can't reach the real `claude` CLI, which keeps
            its own config (~/.claude.json). Point ClaudeCliMcpRegistrar at a
            binary that doesn't exist so no test can `claude mcp add` into the
            developer's real user-scope config.
          -->
          <environmentVariables>
            <AGENTIC_SKILLS_HOME_OVERRIDE>${project.build.directory}/test-home</AGENTIC_SKILLS_HOME_OVERRIDE>
            <AGENTIC_SKILLS_CLAUDE_CLI_OVERRIDE>${project.build.directory}/no-such-claude</AGENTIC_SKILLS_CLAUDE_CLI_OVERRIDE>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
